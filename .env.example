# Copy this file to .env and adjust values as needed.
# With Docker Compose (recommended), the defaults below already work —
# "postgres" resolves to the postgres service on the Compose network.

DATABASE_URL="postgresql://hubble:hubble@postgres:5432/hubble"

NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Timezone used for Consult Now slot generation (IANA name).
CONSULT_TIMEZONE="Asia/Kolkata"

# --- Google Calendar / Meet (optional) --------------------------------
# Leave these blank to run the Consult Now flow in mock mode: slots are
# still bookable, but no real Calendar event or Meet link is created.
# See README.md "Enabling real Google Calendar + Meet" for setup steps.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""
GOOGLE_CALENDAR_ID="primary"

# --- Resend (optional) --------------------------------------------------
# Leave blank to log confirmation emails to the server console instead of
# sending them. See README.md "Enabling real email delivery" for setup.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="consult@hubble.example"

# Leave blank to skip. When set, this address is CC'd on every client
# confirmation email, so the business owner sees each booking as it happens.
ADMIN_NOTIFICATION_EMAIL=""
